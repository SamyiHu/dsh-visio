{
  "name": "dsh-visio",
  "version": "1.24.0",
  "type": "module",
  "description": "Visio (.vsdx) viewer/editor for the DeepSeek Harness Web UI: live SVG preview, shape editing, connectors and a visio agent tool.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "engine/*.py",
    "engine/shape_library.json",
    "README.md"
  ],
  "engines": {
    "node": ">=18",
    "dsh": ">=0.2.1-rc.1 <0.3.0-0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.1 <0.3.0-0"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "^0.1.7-rc.2 || ^0.2.0-rc.1 || ^0.2.1-rc.1 || ^0.2.2-rc.1",
    "@deepseek-ai/dsh-client-locale": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SamyiHu/dsh-visio.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "visio",
    "vsdx",
    "diagram",
    "svg"
  ],
  "author": "SamyiHu",
  "homepage": "https://github.com/SamyiHu/dsh-visio#readme"
}
